# Template for local development config. Copy to .env and fill in real values.
# .env is gitignored — never put real secrets in this file, it IS meant to be committed.

# Azure OpenAI - Embeddings
AZURE_OPENAI_EMBEDDINGS_API_KEY=
AZURE_OPENAI_EMBEDDINGS_API_VERSION=2025-01-01-preview
AZURE_OPENAI_EMBEDDINGS_ENDPOINT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=embeddings

# Azure OpenAI - Chat/Completions (Main LLM)
AZURE_OPENAI_API_TYPE=azure
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# PostgreSQL (Docker, Chapter 5 Part A) - see docs/technical/local-setup.md
# Three separate roles on purpose: a bootstrap superuser (setup only),
# a migrations owner (Chapter 6), and this restricted runtime role the
# app actually connects as. Generate real passwords yourself - never
# reuse the placeholder text below.
POSTGRES_HOST_PORT=5432
POSTGRES_DB=tenderpilot
POSTGRES_BOOTSTRAP_USER=tenderpilot_admin
POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-real-random-value
DATABASE_MIGRATOR_PASSWORD=replace-with-a-real-random-value
DATABASE_APP_PASSWORD=replace-with-a-real-random-value

# SeaweedFS (Docker, Chapter 5 Part B - accepted, ADR 0006) - see docs/technical/local-setup.md
# Three identities: an admin (setup only - create buckets/identities), a
# restricted tenderpilot_app (read/write quarantine, read-only documents),
# and tenderpilot_validator (write-but-not-delete on documents, via an
# attached IAM policy - see infra/compose/seaweedfs-iam-policy.json).
# Generate real random values yourself, e.g. `openssl rand -hex 10` /
# `openssl rand -hex 20` - never reuse these placeholders.
SEAWEEDFS_ADMIN_ACCESS_KEY=replace-with-a-real-random-value
SEAWEEDFS_ADMIN_SECRET_KEY=replace-with-a-real-random-value
SEAWEEDFS_APP_ACCESS_KEY=replace-with-a-real-random-value
SEAWEEDFS_APP_SECRET_KEY=replace-with-a-real-random-value
SEAWEEDFS_VALIDATOR_ACCESS_KEY=replace-with-a-real-random-value
SEAWEEDFS_VALIDATOR_SECRET_KEY=replace-with-a-real-random-value

# Backend -> SeaweedFS connection (Chapter 5 work item 5, closed 2026-09-12 -
# see backend/src/tenderpilot/storage.py). Only the app access/secret keys
# above are used here - never the admin or validator credential. Not a
# secret itself; only present so the default is visible and overridable.
SEAWEEDFS_ENDPOINT_URL=http://127.0.0.1:8333

# RabbitMQ (Docker, Chapter 5 Part C - broker only, no job workers yet) -
# see docs/technical/local-setup.md. Same two-role pattern: an admin user
# (administrator tag, setup/inspection only) and a restricted app user
# (permissions scoped by name to "tenderpilot.*" resources only). Generate
# real random values yourself - never reuse these placeholders.
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_ADMIN_USER=tenderpilot_admin
RABBITMQ_ADMIN_PASSWORD=replace-with-a-real-random-value
RABBITMQ_APP_USER=tenderpilot_app
RABBITMQ_APP_PASSWORD=replace-with-a-real-random-value

# Keycloak (Docker, Chapter 5 Part D - local identity server only, no
# TenderPilot login routes/org membership/tenant isolation yet - that's
# Chapter 7) - see docs/technical/local-setup.md. Keycloak gets its own
# Postgres database and role (KEYCLOAK_DB_*), separate from the
# tenderpilot database. The Keycloak administrator (KEYCLOAK_BOOTSTRAP_
# ADMIN_*, master realm) is entirely separate from the disposable test
# user (KEYCLOAK_TEST_USER*, tenderpilot realm). Generate real random
# values yourself - never reuse these placeholders.
KEYCLOAK_HOST_PORT=8080
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=tenderpilot_keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-real-random-value
KEYCLOAK_BOOTSTRAP_ADMIN_USER=kc_admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-real-random-value
KEYCLOAK_TEST_USER=tenderpilot_test_user
KEYCLOAK_TEST_USER_PASSWORD=replace-with-a-real-random-value
